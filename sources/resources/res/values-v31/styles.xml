<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@null</item>
        <item name="android:textColorHighlight">@color/accent_trans</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
        <item name="android:listChoiceIndicatorMultiple">@drawable/menu_icon_select</item>
        <item name="android:dialogTheme">@style/DialogDefaultTheme</item>
        <item name="android:textDirection">locale</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/white</item>
    </style>
    <style name="Base.Theme.SplashScreen" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="isLightTheme">?android:attr/isLightTheme</item>
    </style>
    <style name="DialogBaseTheme" parent="@style/Theme.AppCompat.Light.Dialog">
        <item name="android:backgroundDimAmount">0.2</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorHighlight">@color/accent_trans</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
        <item name="android:listChoiceIndicatorMultiple">@drawable/menu_icon_select</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>
    <style name="Theme.SplashScreen" parent="@style/Base.Theme.SplashScreen.DayNight">
        <item name="?0x101062c">?attr/windowSplashScreenBackground</item>
        <item name="?0x101062d">?attr/windowSplashScreenAnimatedIcon</item>
        <item name="?0x101062e">?attr/windowSplashScreenAnimationDuration</item>
    </style>
</resources>
