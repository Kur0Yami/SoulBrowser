<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SplashTheme" parent="@style/Theme.SplashScreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="postSplashScreenTheme">@style/WebViewTheme</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash_night</item>
    </style>
    <style name="WebViewTheme" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimaryDark">@color/black</item>
    </style>
</resources>
